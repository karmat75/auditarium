{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "Auditarium",
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "Auditarium": {
    "Database": {
      "Provider": "SqlServer",
      "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=Auditarium;Trusted_Connection=True;TrustServerCertificate=True",
      "BootstrapTimeoutSeconds": 180
    },
    "Storage": {
      "RootPath": "../../.auditarium/storage"
    },
    "DataProtection": {
      "KeyRingPath": "../../.auditarium/keys",
      "ApplicationName": "Auditarium"
    },
    "Retention": {
      "DeletionDays": 90,
      "DeletionPurgeEnabled": true,
      "AuditLogDays": 365,
      "AuditLogPurgeEnabled": false
    },
    "Recovery": {
      "Enabled": false,
      "DefaultAdminPassword": ""
    },
    "DemoData": {
      "Enabled": false
    },
    "Security": {
      "LocalPassword": {
        "MinimumLength": 15,
        "MaximumLength": 128
      },
      "LocalLockout": {
        "FailedAttempts": 5,
        "WindowMinutes": 15,
        "DurationMinutes": 15
      },
      "ApiCredentials": {
        "DefaultLifetimeDays": 180,
        "MaximumActiveCredentials": 5
      }
    },
    "Files": {
      "OriginalDocuments": {
        "MaxUploadSize": 104857600,
        "MaxDownloadSize": 104857600
      }
    },
    "Jobs": {
      "Retention": {
        "Enabled": true,
        "Schedule": "0 3 * * *",
        "TimeZone": "Europe/Berlin",
        "RunOnStartup": false,
        "MisfirePolicy": "Skip",
        "ConcurrencyPolicy": "SkipIfRunning"
      }
    }
  },
  "AllowedHosts": "*"
}
