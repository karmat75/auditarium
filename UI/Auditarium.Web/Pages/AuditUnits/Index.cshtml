@page "/audit-units"
@model Auditarium.Web.Pages.AuditUnits.IndexModel
@{ ViewData["Title"] = "Audit Units"; }
<h1>Audit Units</h1>

<section class="card aud-data-card" aria-labelledby="audit-unit-grid-title">
    <div class="card-header">
        <h2 class="card-title" id="audit-unit-grid-title">Audit Units</h2>
        <div class="card-tools">
            <form method="get" class="aud-grid-search" role="search">
                <label class="visually-hidden" asp-for="Search">Audit Units suchen</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
                    <input asp-for="Search" class="form-control" placeholder="Suchen..." aria-label="Audit Units suchen" />
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-page="./Index" class="btn btn-outline-secondary" aria-label="Suche zurücksetzen"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>
    <div class="card-body">
        <div class="aud-grid-actions d-flex gap-2 flex-wrap mb-3">
            <a asp-page="Create" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="ms-1">Audit Unit anlegen</span></a>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-aud-tree-export="csv">Export CSV</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-aud-tree-export="json">Export JSON</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-aud-tree-print>Print</button>
        </div>
        @if (Model.Hierarchy.Count == 0)
        {
            <div class="aud-empty-state">Keine Audit Units entsprechen der aktuellen Suche.</div>
        }
        else
        {
            <div class="table-responsive aud-tabulator-fallback">
                <table class="table aud-table"><thead><tr><th>Name</th><th>Typ</th><th>Status</th><th>Aktion</th></tr></thead><tbody>
                @foreach (var unit in Model.Hierarchy)
                {
                    <tr><td style="padding-inline-start: calc(.75rem + @unit.Depth * 1.5rem)">@unit.Name</td><td>@unit.ScopeTypeName</td><td><aud-status value="@unit.UsageState" /></td><td><div class="aud-audit-unit-fallback-actions">@if (Model.CanManage) { <a asp-page="Details" asp-route-id="@unit.AuditUnitId" class="btn btn-outline-secondary btn-sm">Details</a><a asp-page="Edit" asp-route-id="@unit.AuditUnitId" class="btn btn-outline-secondary btn-sm">Bearbeiten</a> } @if (Model.CanDelete) { <form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="id" value="@unit.AuditUnitId" /><input type="hidden" name="concurrencyVersion" value="@unit.ConcurrencyVersion" /><button type="submit" class="btn btn-outline-danger btn-sm">Löschen</button></form> }</div></td></tr>
                }
                </tbody></table>
            </div>
            <div class="aud-tabulator aud-audit-unit-tree-grid" data-aud-tabulator data-aud-tree="true" data-aud-table-url="@Url.Page("./Index", "Tree", new { search = Model.Search })" data-aud-default-sort="name" data-aud-default-direction="asc" data-aud-columns='[{"title":"Name","field":"name","sortable":true,"minWidth":408,"widthGrow":1},{"title":"Typ","field":"scopeType","scopeType":true,"sortable":true,"width":220,"minWidth":220},{"title":"Status","field":"usageState","status":true,"sortable":true,"width":160,"minWidth":160},{"title":"Aktionen","field":"actions","actions":[{"urlField":"detailsUrl","visibleField":"canManage","label":"Details","icon":"bi bi-eye","buttonClass":"btn btn-outline-secondary btn-sm aud-tabulator-action"},{"urlField":"editUrl","visibleField":"canManage","label":"Audit Unit bearbeiten","icon":"bi bi-pencil-square","buttonClass":"btn btn-outline-secondary btn-sm aud-tabulator-action"},{"action":"deleteAuditUnit","visibleField":"canDelete","label":"Audit Unit löschen","icon":"bi bi-trash-fill","buttonClass":"btn btn-outline-danger btn-sm aud-tabulator-action"}],"width":156,"minWidth":156,"hozAlign":"center"}]'></div>
        }
    </div>
</section>

<div class="modal fade" id="delete-audit-unit-modal" tabindex="-1" aria-labelledby="delete-audit-unit-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content"><form method="post" asp-page-handler="Delete"><div class="modal-header"><h2 class="modal-title fs-5" id="delete-audit-unit-title">Audit Unit löschen</h2><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Schließen"></button></div><div class="modal-body"><p>Die Audit Unit <strong data-aud-delete-name></strong> wird gelöscht. Dieser Vorgang kann nicht rückgängig gemacht werden.</p><label class="form-label" for="delete-audit-unit-reason">Optionale Begründung</label><input class="form-control" id="delete-audit-unit-reason" name="reason" /><input type="hidden" name="id" data-aud-delete-id /><input type="hidden" name="concurrencyVersion" data-aud-delete-version /></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button><button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill" aria-hidden="true"></i><span class="ms-1">Löschen</span></button></div></form></div></div>
</div>

@section Scripts {
    <script src="~/js/audit-units.js" asp-append-version="true" defer></script>
}
