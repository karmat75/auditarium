@page "/audit-units"
@model Auditarium.Web.Pages.AuditUnits.IndexModel
@{ ViewData["Title"] = "Audit Units"; }
<h1>Audit Units</h1>
<p><a asp-page="Create">Audit Unit anlegen</a></p>
<form method="get"><label asp-for="Search">Suche</label><input asp-for="Search" /><button type="submit">Suchen</button></form>
<h2>Hierarchie</h2>
<ul>@foreach (var unit in Model.Hierarchy) { <li style="margin-left:@(unit.Depth * 1.5)rem"><a asp-page="Details" asp-route-id="@unit.AuditUnitId">@unit.Name</a> – @unit.ScopeTypeName (@unit.UsageState)</li> }</ul>
<h2>Liste</h2>
<table><thead><tr><th>Name</th><th>Parent</th><th>Scope Type</th><th>Nutzungszustand</th></tr></thead><tbody>@foreach (var unit in Model.AuditUnits) { <tr><td><a asp-page="Details" asp-route-id="@unit.AuditUnitId">@unit.Name</a></td><td>@unit.ParentName</td><td>@unit.ScopeTypeName</td><td>@unit.UsageState</td></tr> }</tbody></table>
