@model Auditarium.Web.Pages.AuditUnits.AuditUnitInputModel
@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper Html
@{ var cancelUrl = ViewData["CancelUrl"] as string; }
<form method="post" class="aud-form">
    <partial name="~/Pages/Shared/_ValidationSummary.cshtml" />
    <div class="aud-form-field"><label asp-for="Name">Name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name"></span></div>
    <div class="aud-form-field"><label asp-for="ParentAuditUnitId">Übergeordnete Audit Unit</label><select asp-for="ParentAuditUnitId" class="form-select"><option value="">Kein Parent</option>@foreach (var parent in ViewBag.AuditUnits as IReadOnlyList<Auditarium.Bll.Features.Audits.AuditUnitListItem> ?? []) { <option value="@parent.AuditUnitId">@parent.Name (@parent.ScopeTypeName)</option> }</select></div>
    <div class="aud-form-field"><label asp-for="ScopeTypeId">Scope Type</label><select asp-for="ScopeTypeId" class="form-select">@foreach (var scope in ViewBag.ScopeTypes as IReadOnlyList<Auditarium.Bll.Features.Catalog.ScopeTypeItem> ?? []) { <option value="@scope.ScopeTypeId">@scope.Name</option> }</select></div>
    <div class="aud-form-field"><label asp-for="Description">Beschreibung</label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="aud-form-field"><label asp-for="UsageState">Nutzungszustand</label><select asp-for="UsageState" class="form-select" asp-items="Html.GetEnumSelectList<Auditarium.Models.Catalog.AuditUnitUsageState>()"></select></div>
    <div class="aud-form-field"><label asp-for="UsageStateReason">Begründung bei INACTIVE</label><input asp-for="UsageStateReason" class="form-control" /></div>
    <div class="aud-form-field"><label asp-for="Notes">Interne Hinweise</label><textarea asp-for="Notes" class="form-control"></textarea></div>
    <input asp-for="ConcurrencyVersion" type="hidden" />
    <div class="aud-form-actions"><button type="submit" class="btn btn-primary">Speichern</button>@if (!string.IsNullOrWhiteSpace(cancelUrl)) { <a href="@cancelUrl" class="btn btn-outline-secondary">Abbrechen</a> }</div>
</form>
