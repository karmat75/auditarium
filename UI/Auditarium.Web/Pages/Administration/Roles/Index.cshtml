@page "/administration/roles"
@model Auditarium.Web.Pages.Administration.Roles.IndexModel
@{ ViewData["Title"] = "Rollen"; }
<h1>Rollen</h1><div asp-validation-summary="All"></div><p><a asp-page="Create">Custom Role anlegen</a></p>
<table><thead><tr><th>Name</th><th>Typ</th><th>Status</th><th>Benutzer</th><th>Permissions</th></tr></thead><tbody>
@foreach (var role in Model.Roles) { <tr><td><a asp-page="Details" asp-route-id="@role.RoleId">@role.Name</a></td><td>@(role.RoleKey is null ? "Benutzerdefiniert" : "Systemverwaltet")</td><td>@(role.IsActive ? "Aktiv" : "Inaktiv")</td><td>@role.UserCount</td><td>@role.PermissionCount</td></tr> }
</tbody></table>
