@page "/administration/authentication-providers"
@model Auditarium.Web.Pages.Administration.AuthenticationProviders.IndexModel
@{ ViewData["Title"] = "Authentication Provider"; }
<h1>Authentication Provider</h1><div asp-validation-summary="All"></div><p><a asp-page="Create">LDAP-Instanz anlegen</a></p>
<table><thead><tr><th>Key</th><th>Name</th><th>Typ</th><th>Status</th><th>Verwaltung</th></tr></thead><tbody>
@foreach (var provider in Model.Providers) { <tr><td><a asp-page="Details" asp-route-id="@provider.ProviderId">@provider.ProviderKey</a></td><td>@provider.DisplayName</td><td>@provider.ProviderType</td><td>@(provider.IsEnabled ? "Aktiv" : "Inaktiv")</td><td>@(provider.SystemManaged ? "Systemverwaltet" : "Administrierbar")</td></tr> }
</tbody></table>
