@page "/audits"
@model Auditarium.Web.Pages.Audits.IndexModel
@{ ViewData["Title"] = "Audits"; }
<h1>Audits</h1>
<p class="aud-action-bar"><a asp-page="Create" class="btn btn-primary">Audit anlegen</a></p>
<form method="get" class="filter-form"><div><label asp-for="Search">Suche</label><input asp-for="Search" class="form-control" /></div><div><label asp-for="State">Zustand</label><select asp-for="State" class="form-select" asp-items="Html.GetEnumSelectList<Auditarium.Models.Catalog.AuditState>()"><option value="">Alle</option></select></div><div class="align-self-end"><button type="submit" class="btn btn-outline-secondary">Filtern</button></div></form>
<div class="table-responsive"><table class="table aud-table"><thead><tr><th>Name</th><th>Audit Unit</th><th>Katalog</th><th>Zustand</th><th>Bearbeitung</th><th>Erstellt</th></tr></thead><tbody>@if (Model.Audits.Count == 0) { <tr><td colspan="6" class="aud-empty-state">Keine Audits gefunden. <a asp-page="Create">Jetzt das erste Audit anlegen.</a></td></tr> } else { @foreach (var audit in Model.Audits) { <tr><td><a asp-page="Details" asp-route-id="@audit.AuditId">@audit.Name</a></td><td>@audit.AuditUnitName</td><td>@audit.DocumentTitle v@audit.CatalogVersionNumber</td><td><aud-status value="@audit.AuditState" /></td><td>@(audit.AssignedAuditorDisplayName is null ? "Nicht zugewiesen" : $"In Bearbeitung durch {audit.AssignedAuditorDisplayName}")</td><td>@audit.CreatedAt.LocalDateTime</td></tr> } }</tbody></table></div>
