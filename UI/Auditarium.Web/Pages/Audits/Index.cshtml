@page "/audits"
@model Auditarium.Web.Pages.Audits.IndexModel
@{ ViewData["Title"] = "Audits"; }
<h1>Audits</h1>
@if (Model.Audits.Count > 0) { <p class="aud-action-bar"><a asp-page="Create" class="btn btn-primary">Audit anlegen</a></p> }
<form method="get" class="filter-form"><div><label asp-for="Search">Suche</label><input asp-for="Search" class="form-control" /></div><div><label asp-for="State">Zustand</label><select asp-for="State" class="form-select" asp-items="Html.GetEnumSelectList<Auditarium.Models.Catalog.AuditState>()"><option value="">Alle</option></select></div><div class="align-self-end"><button type="submit" class="btn btn-outline-secondary">Filtern</button></div></form>
@if (Model.Audits.Count == 0) { <div class="aud-empty-state"><p>Keine Audits gefunden.</p><a asp-page="Create" class="btn btn-primary">Audit anlegen</a></div> } else { <div class="table-responsive aud-tabulator-fallback"><table class="table aud-table"><thead><tr><th>Name</th><th>Audit Unit</th><th>Katalog</th><th>Zustand</th><th>Bearbeitung</th><th>Erstellt</th></tr></thead><tbody>@foreach (var audit in Model.Audits) { <tr><td><a asp-page="Details" asp-route-id="@audit.AuditId">@audit.Name</a></td><td>@audit.AuditUnitName</td><td>@audit.DocumentTitle v@audit.CatalogVersionNumber</td><td><aud-status value="@audit.AuditState" /></td><td>@(audit.AssignedAuditorDisplayName is null ? "Nicht zugewiesen" : $"In Bearbeitung durch {audit.AssignedAuditorDisplayName}")</td><td>@audit.CreatedAt.LocalDateTime</td></tr> }</tbody></table></div><div data-aud-tabulator data-aud-table-url="@Url.Page("./Index", "Table")" data-aud-default-sort="createdAt" data-aud-default-direction="desc" data-aud-columns='[{"title":"Name","field":"name","linkField":"detailsUrl","sortable":true,"minWidth":220},{"title":"Audit Unit","field":"auditUnit","minWidth":180},{"title":"Katalog","field":"catalog","minWidth":220},{"title":"Zustand","field":"state","status":true,"sortField":"state","sortable":true,"minWidth":150},{"title":"Bearbeitung","field":"assignment","minWidth":240},{"title":"Erstellt","field":"createdAt","sortable":true,"minWidth":150}]'></div> }
