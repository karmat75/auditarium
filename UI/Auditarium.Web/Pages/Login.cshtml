@page "/login"
@model Auditarium.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Anmelden";
}
<main>
    <h1>Anmelden</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <label asp-for="Username">Benutzername</label>
        <input asp-for="Username" autocomplete="username" />
        <label asp-for="Password">Passwort</label>
        <input asp-for="Password" type="password" autocomplete="current-password" />
        <label asp-for="Provider">Provider (optional)</label>
        <input asp-for="Provider" />
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit">Anmelden</button>
    </form>
</main>
