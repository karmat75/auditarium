@model Auditarium.Web.Pages.Documents.DocumentInputModel
<form method="post" class="aud-form">
    <partial name="~/Pages/Shared/_ValidationSummary.cshtml" />
    <div class="aud-form-field"><label asp-for="Title">Titel</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title"></span></div>
    <div class="aud-form-field"><label asp-for="Publisher">Herausgeber</label><input asp-for="Publisher" class="form-control" /></div>
    <div class="aud-form-field"><label asp-for="Version">Herausgeber-Version</label><input asp-for="Version" class="form-control" /></div>
    <div class="aud-form-field"><label asp-for="PublicationDate">Veröffentlichungsdatum</label><input asp-for="PublicationDate" class="form-control" type="date" /></div>
    <div class="aud-form-field"><label asp-for="Source">Quelle</label><input asp-for="Source" class="form-control" /></div>
    <div class="aud-form-field"><label asp-for="UsageState">Nutzungszustand</label><select asp-for="UsageState" class="form-select" asp-items="Html.GetEnumSelectList<Auditarium.Models.Catalog.DocumentUsageState>()"></select></div>
    <div class="aud-form-field"><label asp-for="UsageStateReason">Begründung bei Außerbetriebnahme</label><input asp-for="UsageStateReason" class="form-control" /></div>
    <div class="aud-form-field"><label asp-for="Notes">Hinweise</label><textarea asp-for="Notes" class="form-control"></textarea></div>
    <input asp-for="ConcurrencyVersion" type="hidden" />
    <div class="aud-form-actions"><button type="submit" class="btn btn-primary">Speichern</button></div>
</form>
