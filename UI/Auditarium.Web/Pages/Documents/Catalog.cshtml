@page "/catalog-versions/{id:long}"
@model Auditarium.Web.Pages.Documents.CatalogModel
@{
    ViewData["Title"] = $"Katalogversion {Model.Catalog.VersionNumber}";
}
<p><a asp-page="Details" asp-route-id="@Model.Catalog.DocumentId">Zurück zum Regelwerk</a></p>
<h1>Katalogversion @Model.Catalog.VersionNumber</h1>
<dl><dt>Zustand</dt><dd>@Model.Catalog.CatalogState</dd><dt>DRAFT-Revision</dt><dd>@Model.Catalog.DraftRevision</dd></dl>
<form method="post" asp-page-handler="Copy"><input type="hidden" name="concurrencyVersion" value="@Model.Catalog.ConcurrencyVersion" /><button type="submit">Als neue Version kopieren</button></form>
@if (Model.Catalog.CatalogState == Auditarium.Models.Catalog.CatalogState.Draft)
{
    <form method="post" asp-page-handler="Ready"><input type="hidden" name="concurrencyVersion" value="@Model.Catalog.ConcurrencyVersion" /><button type="submit">Freigabe bestätigen (READY)</button></form>
    <h2>Dokumentelemente und Fragen</h2>
    <form method="post" asp-page-handler="AddElement">
        <label asp-for="ElementInput.ParentElementId">Übergeordnetes Element</label><select asp-for="ElementInput.ParentElementId"><option value="">Oberste Ebene</option>@foreach (var item in Model.Editor.Elements) { <option value="@item.ElementId">@item.Title (@item.ElementId)</option> }</select>
        <label asp-for="ElementInput.Title">Titel</label><input asp-for="ElementInput.Title" /><label asp-for="ElementInput.Text">Text</label><textarea asp-for="ElementInput.Text"></textarea><label asp-for="ElementInput.Notes">Hinweise</label><input asp-for="ElementInput.Notes" /><button type="submit">Element anlegen</button>
    </form>
    @foreach (var element in Model.Editor.Elements)
    {
        <section><h3>@element.Title <small>Reihenfolge: @element.SortOrder, Gewicht: @element.Weight</small></h3><p>@element.Text</p>
            <form method="post" asp-page-handler="UpdateElement"><input name="ElementInput.ElementId" type="hidden" value="@element.ElementId" /><label>Titel <input name="ElementInput.Title" value="@element.Title" /></label><label>Text <textarea name="ElementInput.Text">@element.Text</textarea></label><label>Hinweise <input name="ElementInput.Notes" value="@element.Notes" /></label><button type="submit">Element bearbeiten</button></form>
            <form method="post" asp-page-handler="MoveElement"><input name="ElementInput.ElementId" type="hidden" value="@element.ElementId" /><label>Parent <select name="ElementInput.ParentElementId"><option value="">Oberste Ebene</option>@foreach (var candidate in Model.Editor.Elements.Where(x => x.ElementId != element.ElementId)) { <option value="@candidate.ElementId" selected="@(candidate.ElementId == element.ParentElementId)">@candidate.Title</option> }</select></label><label>Reihenfolge <input name="ElementInput.SortOrder" type="number" min="0" value="@element.SortOrder" /></label><button type="submit">Verschieben</button></form>
            <form method="post" asp-page-handler="PreviewDeleteElement"><input name="ElementInput.ElementId" type="hidden" value="@element.ElementId" /><button type="submit">Löschen prüfen</button></form>
            @if (Model.DeletePreviewElementId == element.ElementId && Model.DeletePreview is not null) { <p>Es werden @Model.DeletePreview.DescendantElementCount untergeordnete Elemente, @Model.DeletePreview.QuestionCount Fragen und @Model.DeletePreview.ScopeAssignmentCount Scope-Zuordnungen gelöscht.</p><form method="post" asp-page-handler="DeleteElement"><input name="ElementInput.ElementId" type="hidden" value="@element.ElementId" /><button type="submit">Löschen endgültig bestätigen</button></form> }
            <form method="post" asp-page-handler="SetWeight"><input name="WeightInput.ElementId" type="hidden" value="@element.ElementId" /><label>Gewicht <select name="WeightInput.Weight">@for (var weight = 1; weight <= 5; weight++) { <option value="@weight" selected="@(weight == element.Weight)">@weight</option> }</select></label><button type="submit">Gewicht speichern</button></form>
            @foreach (var question in element.Questions) { <div><strong>Frage @question.SortOrder:</strong> @question.Text <form method="post" asp-page-handler="UpdateQuestion"><input name="QuestionInput.QuestionId" type="hidden" value="@question.QuestionId" /><label>Text <input name="QuestionInput.Text" value="@question.Text" required /></label><label>Scopes <select name="QuestionInput.ScopeTypeIds" multiple required>@foreach (var scope in Model.Editor.ScopeTypes) { <option value="@scope.ScopeTypeId" selected="@(question.ScopeTypeIds.Contains(scope.ScopeTypeId))">@scope.Name</option> }</select></label><button type="submit">Frage bearbeiten</button></form><form method="post" asp-page-handler="MoveQuestion"><input name="QuestionInput.QuestionId" type="hidden" value="@question.QuestionId" /><label>Reihenfolge <input name="QuestionInput.SortOrder" type="number" min="0" value="@question.SortOrder" /></label><button type="submit">Frage sortieren</button></form><form method="post" asp-page-handler="DeleteQuestion"><input name="QuestionInput.QuestionId" type="hidden" value="@question.QuestionId" /><button type="submit">Frage löschen</button></form></div> }
            <form method="post" asp-page-handler="AddQuestion"><input name="QuestionInput.ElementId" type="hidden" value="@element.ElementId" /><label>Frage <input name="QuestionInput.Text" required /></label><label>Scopes <select name="QuestionInput.ScopeTypeIds" multiple required>@foreach (var scope in Model.Editor.ScopeTypes) { <option value="@scope.ScopeTypeId">@scope.Name</option> }</select></label><button type="submit">Frage anlegen</button></form>
        </section>
    }
    <h2>Katalogimport</h2>
    <form method="post" asp-page-handler="ValidateImport"><label asp-for="ImportInput.PackageJson">Import Package (JSON)</label><textarea asp-for="ImportInput.PackageJson" required></textarea><button type="submit">Validieren und Vorschau anzeigen</button></form>
    @if (Model.ImportReport is not null) { <section><h3>Importvorschau: @Model.ImportReport.Status</h3><p>@Model.ImportReport.RecognizedElementCount Elemente, @Model.ImportReport.RecognizedQuestionCount Fragen</p><ul>@foreach (var issue in Model.ImportReport.Errors) { <li>@issue.Code: @issue.Message</li> } @foreach (var issue in Model.ImportReport.Warnings) { <li>@issue.Code: @issue.Message</li> }</ul><form method="post" asp-page-handler="ApplyImport"><input type="hidden" asp-for="ImportInput.PackageJson" /><label asp-for="ImportInput.Mode">Übernahme</label><select asp-for="ImportInput.Mode"><option value="Full">Alle gültigen Wurzeln</option><option value="Partial">Ausgewählte Wurzeln</option></select>@foreach (var root in Model.ImportReport.ApplicableRoots) { <label><input type="checkbox" name="ImportInput.SelectedRootElementIds" value="@root.ElementId" /> @root.ElementId (@root.ElementCount Elemente)</label> }<button type="submit">Übernahme bewusst ausführen</button></form></section> }
    <h2>Originaldokument</h2>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload"><input type="hidden" name="concurrencyVersion" value="@Model.Catalog.ConcurrencyVersion" /><label for="sourceFile">PDF-Datei</label><input id="sourceFile" name="sourceFile" type="file" accept="application/pdf,.pdf" /><button type="submit">Hochladen oder ersetzen</button></form>
    @if (Model.Catalog.HasSourceFile) { <form method="post" asp-page-handler="Remove"><input type="hidden" name="concurrencyVersion" value="@Model.Catalog.ConcurrencyVersion" /><button type="submit">Originaldokument entfernen</button></form> }
}
else
{
    <form method="post" asp-page-handler="Draft"><input type="hidden" name="concurrencyVersion" value="@Model.Catalog.ConcurrencyVersion" /><button type="submit">Zurück zu DRAFT</button></form>
}
@if (Model.Catalog.HasSourceFile) { <p><a asp-page-handler="Download">Originaldokument herunterladen</a></p> }
