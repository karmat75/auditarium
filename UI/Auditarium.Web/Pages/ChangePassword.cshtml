@page "/account/change-password"
@model Auditarium.Web.Pages.ChangePasswordModel
<main>
    <h1>Passwort ändern</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <label asp-for="CurrentPassword">Aktuelles Passwort</label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
        <label asp-for="NewPassword">Neues Passwort</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" />
        <button type="submit">Passwort ändern</button>
    </form>
</main>
