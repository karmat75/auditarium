@page "/account/change-password"
@model Auditarium.Web.Pages.ChangePasswordModel
<h1>Passwort ändern</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <label asp-for="Input.CurrentPassword">Aktuelles Passwort</label>
    <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />
    <span asp-validation-for="Input.CurrentPassword"></span>
    <label asp-for="Input.NewPassword">Neues Passwort</label>
    <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
    <span asp-validation-for="Input.NewPassword"></span>
    <button type="submit">Passwort ändern</button>
</form>
