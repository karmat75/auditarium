{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Auditarium Web",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/UI/Auditarium.Web/Auditarium.Web.csproj",
        "--configuration",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Auditarium API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/UI/Auditarium.Api/Auditarium.Api.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
