{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Auditarium Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Auditarium Web",
      "program": "${workspaceFolder}/UI/Auditarium.Web/bin/Debug/net10.0/Auditarium.Web.dll",
      "cwd": "${workspaceFolder}/UI/Auditarium.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Auditarium API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Auditarium API",
      "program": "${workspaceFolder}/UI/Auditarium.Api/bin/Debug/net10.0/Auditarium.Api.dll",
      "cwd": "${workspaceFolder}/UI/Auditarium.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5001"
      },
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Auditarium Web + API",
      "configurations": [
        "Auditarium Web",
        "Auditarium API"
      ],
      "stopAll": true
    }
  ]
}
